<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="SimulationUI.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">

        <ui:VisualElement name="indicatorsPanel" class="stats-panel" picking-mode="Ignore">
            <ui:Label text="INDICADORES" class="indicators-head" picking-mode="Ignore" />
            <ui:VisualElement class="indicators-body" picking-mode="Ignore">
                <ui:Label name="particleCountLabel" text="Partículas: 0" class="particle-count-label" picking-mode="Ignore" />
                <ui:VisualElement class="indicators-divider" picking-mode="Ignore" />
                <ui:Label name="movementsLabel" text="Movimentos: 0" class="stats-label" picking-mode="Ignore" />
                <ui:Label name="collisionsLabel" text="Colisões: 0" class="stats-label" picking-mode="Ignore" />
                <ui:Label name="invalidMovementsLabel" text="Movimentos inválidos: 0" class="stats-label" picking-mode="Ignore" />
                <ui:Label name="fpsLabel" text="FPS: 0" class="stats-label" picking-mode="Ignore" />
                <ui:Label name="timeLabel" text="Tempo decorrido: 0.0s" class="stats-label" picking-mode="Ignore" />
                <ui:Label name="cyclesLabel" text="Ciclos: 0" class="stats-label" picking-mode="Ignore" />
                <ui:Label name="lastMovementCycleLabel" text="Ciclo do último movimento: —" class="stats-label" picking-mode="Ignore" />
                <ui:Label name="stepTimeLabel" text="Tempo por ciclo: 0.0ms" class="stats-label" picking-mode="Ignore" />
                <ui:Label name="messagesSentLabel" text="Mensagens enviadas: 0" class="stats-label" picking-mode="Ignore" />
                <ui:Label name="messagesDeliveredLabel" text="Mensagens recebidas: 0" class="stats-label" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="floatingControlsWrap" class="floating-controls-wrap" picking-mode="Ignore">
            <ui:VisualElement name="floatingControls" class="floating-controls">
                <ui:Button name="runButton" tooltip="Iniciar" class="icon-button run-button">
                    <ui:VisualElement class="icon-play" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="pauseButton" tooltip="Pausar" class="icon-button pause-button">
                    <ui:VisualElement class="icon-pause" picking-mode="Ignore">
                        <ui:VisualElement class="pause-bar" picking-mode="Ignore" />
                        <ui:VisualElement class="pause-bar" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="stopButton" tooltip="Encerrar" class="icon-button stop-button">
                    <ui:VisualElement class="icon-stop" picking-mode="Ignore" />
                </ui:Button>

                <ui:VisualElement class="controls-separator" picking-mode="Ignore" />

                <ui:Button name="expandButton" tooltip="Ampliar / recolher painel lateral" class="icon-button expand-button">
                    <ui:VisualElement class="icon-expand" picking-mode="Ignore">
                        <ui:VisualElement class="expand-bar expand-bar-tl-h" picking-mode="Ignore" />
                        <ui:VisualElement class="expand-bar expand-bar-tl-v" picking-mode="Ignore" />
                        <ui:VisualElement class="expand-bar expand-bar-br-h" picking-mode="Ignore" />
                        <ui:VisualElement class="expand-bar expand-bar-br-v" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="reframeButton" tooltip="Focar câmera nas partículas (F)" class="icon-button reframe-button">
                    <ui:VisualElement class="icon-camera" picking-mode="Ignore">
                        <ui:VisualElement class="icon-camera-lens" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="filePanel" class="file-panel">
            <ui:VisualElement name="sidebarHead" class="sidebar-head">
                <ui:Label text="PAINEL DE CONFIGURAÇÃO" class="sidebar-title" />
                <ui:VisualElement class="sidebar-head-right">
                    <ui:Button name="fullscreenButton" tooltip="Tela Cheia" class="icon-button fullscreen-button">
                        <ui:VisualElement class="icon-fullscreen" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="quitButton" tooltip="Sair" class="icon-button quit-button">
                        <ui:VisualElement class="icon-quit" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:ScrollView name="sideBody" class="side-body" mode="Vertical">
                <ui:VisualElement class="file-card">
                    <ui:Label text="CONFIGURAÇÃO DO CENÁRIO" class="file-card-title" />
                    <ui:Label text="Arquivo ativo" class="field-label" />
                    <ui:VisualElement class="file-row">
                        <ui:Label name="scenarioPathLabel" text="(padrão)" class="file-name" />
                        <ui:Button name="scenarioXButton" text="✕" class="file-x" tooltip="Voltar ao arquivo padrão" />
                    </ui:VisualElement>
                    <ui:Button name="scenarioButton" text="+ Carregar arquivo" class="load-btn" />
                    <ui:ScrollView name="scenarioErrorBox" class="err-box hidden" mode="Vertical">
                        <ui:Label name="scenarioErrorLabel" text="" class="error-label" />
                    </ui:ScrollView>
                </ui:VisualElement>

                <ui:VisualElement class="file-card">
                    <ui:Label text="COMPORTAMENTO DAS PARTÍCULAS" class="file-card-title" />
                    <ui:Label text="Arquivo ativo" class="field-label" />
                    <ui:VisualElement class="file-row">
                        <ui:Label name="behaviorPathLabel" text="(padrão)" class="file-name" />
                        <ui:Button name="behaviorXButton" text="✕" class="file-x" tooltip="Voltar ao arquivo padrão" />
                    </ui:VisualElement>
                    <ui:Button name="behaviorButton" text="+ Carregar arquivo" class="load-btn" />
                    <ui:ScrollView name="behaviorErrorBox" class="err-box hidden" mode="Vertical">
                        <ui:Label name="behaviorErrorLabel" text="" class="error-label" />
                    </ui:ScrollView>
                </ui:VisualElement>

                <ui:Button name="loadButton" text="Carregar simulação" class="load-button" />
                <ui:Label name="statusLabel" text="" class="status-label" />

                <ui:VisualElement class="param-card">
                    <ui:Label text="SIMULAÇÃO" class="file-card-title" />
                    <ui:VisualElement class="param-row">
                        <ui:VisualElement class="param-head">
                            <ui:Label text="Intervalo entre ciclos" class="param-label" />
                            <ui:Label name="stepIntervalValue" tooltip="Clique para digitar" text="—" class="param-value" />
                            <ui:TextField name="stepIntervalInput" class="param-input hidden" />
                        </ui:VisualElement>
                        <ui:Slider name="stepIntervalSlider" low-value="0" high-value="2" class="param-slider" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="param-card">
                    <ui:Label text="VISUALIZAÇÃO" class="file-card-title" />

                    <ui:VisualElement class="param-row">
                        <ui:VisualElement class="param-head">
                            <ui:Label text="Preenchimento do cubo" class="param-label" />
                            <ui:Label name="cubeFillValue" tooltip="Clique para digitar" text="—" class="param-value" />
                            <ui:TextField name="cubeFillInput" class="param-input hidden" />
                        </ui:VisualElement>
                        <ui:Slider name="cubeFillSlider" low-value="0.1" high-value="1" class="param-slider" />
                    </ui:VisualElement>

                    <ui:VisualElement class="param-row">
                        <ui:VisualElement class="param-head">
                            <ui:Label text="Duração da animação" class="param-label" />
                            <ui:Label name="moveDurationValue" tooltip="Clique para digitar" text="—" class="param-value" />
                            <ui:TextField name="moveDurationInput" class="param-input hidden" />
                        </ui:VisualElement>
                        <ui:Slider name="moveDurationSlider" low-value="0" high-value="1" class="param-slider" />
                    </ui:VisualElement>

                    <ui:VisualElement class="param-row">
                        <ui:VisualElement class="param-head">
                            <ui:Label text="Cor das partículas" class="param-label" />
                            <ui:Button name="particleColorButton" tooltip="Escolher cor" class="color-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="param-row">
                        <ui:VisualElement class="param-head">
                            <ui:Label text="Cor dos limites" class="param-label" />
                            <ui:Button name="gridColorButton" tooltip="Escolher cor" class="color-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="param-row">
                        <ui:Toggle name="showGridBoundsToggle" label="Mostrar limites da grade" class="param-toggle" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>

        <ui:VisualElement name="colorPopup" class="popup-overlay hidden" picking-mode="Position">
            <ui:VisualElement class="popup-dialog color-dialog">
                <ui:Label name="colorPopupTitle" text="Escolher cor" class="popup-title" />
                <ui:VisualElement name="colorPopupSwatches" class="swatch-grid" />
                <ui:Button name="colorPopupCancelButton" text="Cancelar" class="color-cancel-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="quitPopup" class="popup-overlay hidden" picking-mode="Position">
            <ui:VisualElement class="popup-dialog">
                <ui:Label text="Deseja realmente sair?" class="popup-title" />
                <ui:VisualElement class="popup-buttons">
                    <ui:Button name="confirmQuitButton" text="Sair" class="popup-button confirm-button" />
                    <ui:Button name="cancelQuitButton" text="Cancelar" class="popup-button cancel-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
