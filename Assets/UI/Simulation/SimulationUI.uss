/*
2026-06-04 AI-Tag
This was created with the help of Assistant, a Unity Artificial Intelligence product.
*/
.root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.top-bar {
    position: absolute;
    top: 14px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.ctrl-button {
    width: 56px;
    height: 56px;
    margin-left: 8px;
    margin-right: 8px;
    padding: 0;
    border-radius: 28px;
    border-width: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(60, 60, 70);
}

.ctrl-button:hover {
    background-color: rgb(80, 80, 95);
}

.ctrl-button:active {
    background-color: rgb(45, 45, 55);
}

.run-button {
    background-color: rgb(46, 160, 87);
}

.run-button:hover {
    background-color: rgb(56, 180, 100);
}

.pause-button {
    background-color: rgb(210, 160, 40);
}

.pause-button:hover {
    background-color: rgb(230, 180, 55);
}

.stop-button {
    background-color: rgb(200, 70, 70);
}

.stop-button:hover {
    background-color: rgb(220, 85, 85);
}

/* ---- Button icons (drawn with shapes, not text) ---- */

/* Play: right-pointing triangle via border trick */
.icon-play {
    width: 0;
    height: 0;
    margin-left: 4px;
    border-top-width: 12px;
    border-bottom-width: 12px;
    border-left-width: 20px;
    border-right-width: 0;
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgba(0, 0, 0, 0);
}

/* Pause: two vertical bars */
.icon-pause {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.pause-bar {
    width: 6px;
    height: 24px;
    margin-left: 3px;
    margin-right: 3px;
    border-radius: 2px;
    background-color: rgb(255, 255, 255);
}

/* Stop: square */
.icon-stop {
    width: 22px;
    height: 22px;
    border-radius: 3px;
    background-color: rgb(255, 255, 255);
}

/* ---- File panel ---- */

.file-panel {
    position: absolute;
    top: 84px;
    right: 18px;
    width: 360px;
    padding: 22px;
    border-radius: 12px;
    background-color: rgba(25, 25, 30, 0.92);
}

.panel-title {
    color: rgb(255, 255, 255);
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 16px;
}

.field-label {
    color: rgb(185, 190, 200);
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.file-button {
    height: 44px;
    border-radius: 8px;
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 15px;
    background-color: rgb(55, 90, 150);
    margin-bottom: 6px;
}

.file-button:hover {
    background-color: rgb(70, 110, 175);
}

.path-label {
    color: rgb(160, 165, 175);
    font-size: 14px;
    white-space: normal;
    margin-bottom: 18px;
}

.load-button {
    height: 50px;
    border-radius: 10px;
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 17px;
    -unity-font-style: bold;
    background-color: rgb(46, 160, 87);
    margin-top: 6px;
}

.load-button:hover {
    background-color: rgb(56, 180, 100);
}

.status-label {
    color: rgb(205, 205, 95);
    font-size: 14px;
    white-space: normal;
    margin-top: 12px;
}

/* Provisional: shows validation errors that blocked a load. Hidden while empty. */
.error-label {
    color: rgb(240, 130, 130);
    font-size: 12px;
    white-space: normal;
    margin-top: 8px;
    display: none;
}

/* ---- Stats panel ---- */

.stats-panel {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 12px;
    border-radius: 8px;
    background-color: rgba(25, 25, 30, 0.7);
}

.stats-label {
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

/* ---- System Bar (Top Right) ---- */

.system-bar {
    position: absolute;
    top: 14px;
    right: 18px;
    flex-direction: row;
}

.sys-button {
    width: 44px;
    height: 44px;
    margin-left: 10px;
    border-radius: 8px;
    background-color: rgba(60, 60, 70, 0.8);
    align-items: center;
    justify-content: center;
    transition-duration: 0.15s;
}

.sys-button:hover {
    background-color: rgb(80, 80, 95);
}

.sys-button:active {
    background-color: rgb(45, 45, 55);
}

.icon-fullscreen {
    width: 24px;
    height: 24px;
    background-image: url("project://database/Assets/UI/Icons/fullscreen.svg");
    -unity-background-image-tint-color: white;
}

.icon-quit {
    width: 24px;
    height: 24px;
    background-image: url("project://database/Assets/UI/Icons/quit.svg");
    -unity-background-image-tint-color: white;
}

.quit-sys-button:hover {
    background-color: rgb(200, 70, 70);
}

/* ---- Popups ---- */

.popup-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.75);
    align-items: center;
    justify-content: center;
    display: none; /* Hidden by default */
}

.popup-dialog {
    width: 340px;
    padding: 30px;
    border-radius: 15px;
    background-color: rgb(35, 35, 45);
    border-width: 1px;
    border-color: rgb(60, 60, 75);
    align-items: center;
}

.popup-title {
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 25px;
    -unity-text-align: middle-center;
}

.popup-buttons {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
}

.popup-button {
    flex: 1;
    height: 44px;
    border-radius: 8px;
    border-width: 0;
    color: white;
    font-size: 15px;
    -unity-font-style: bold;
    margin-left: 5px;
    margin-right: 5px;
}

.confirm-button {
    background-color: rgb(200, 70, 70);
}

.confirm-button:hover {
    background-color: rgb(220, 85, 85);
}

.cancel-button {
    background-color: rgb(75, 75, 85);
}

.cancel-button:hover {
    background-color: rgb(90, 90, 105);
}
