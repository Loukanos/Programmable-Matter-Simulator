/* Unity's default theme adds ~3px margins to Label and Button; zero them so this file alone decides layout. */
Label,
Button {
    margin: 0;
}

.hidden {
    display: none;
}

.root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.floating-controls-wrap {
    position: absolute;
    top: 14px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.floating-controls {
    flex-direction: row;
    align-items: center;
    padding: 6px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(74, 80, 88);
    background-color: rgba(43, 47, 52, 0.85);
}

.controls-separator {
    width: 1px;
    align-self: stretch;
    margin-left: 6px;
    margin-right: 6px;
    background-color: rgb(74, 80, 88);
}

.icon-button {
    width: 40px;
    height: 40px;
    margin-left: 4px;
    margin-right: 4px;
    padding: 0;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(74, 80, 88);
    background-color: rgb(58, 64, 70);
    align-items: center;
    justify-content: center;
    transition-duration: 0.15s;
}

.icon-button:hover {
    background-color: rgb(58, 64, 70);
    border-color: rgb(77, 126, 168);
}

.icon-button:active {
    background-color: rgb(45, 48, 53);
    border-color: rgb(77, 126, 168);
}

.run-button {
    background-color: rgb(77, 126, 168);
    border-color: rgb(77, 126, 168);
}

.run-button:hover {
    background-color: rgb(90, 142, 186);
    border-color: rgb(90, 142, 186);
}

.quit-button:hover {
    border-color: rgb(217, 119, 106);
}

/* Keep border-left-width + margin-left (4/3 of the width) inside the button's 38px content box. */
.icon-play {
    width: 0;
    height: 0;
    margin-left: 8px;
    border-top-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 26px;
    border-right-width: 0;
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgba(0, 0, 0, 0);
}

.icon-pause {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.pause-bar {
    width: 5px;
    height: 18px;
    margin-left: 2.5px;
    margin-right: 2.5px;
    border-radius: 2px;
    background-color: rgb(255, 255, 255);
}

.icon-stop {
    width: 17px;
    height: 17px;
    border-radius: 3px;
    background-color: rgb(255, 255, 255);
}

.icon-expand {
    width: 18px;
    height: 18px;
    position: relative;
}

.expand-bar {
    position: absolute;
    background-color: rgb(255, 255, 255);
}

.expand-bar-tl-h {
    top: 0;
    left: 0;
    width: 9px;
    height: 3px;
}

.expand-bar-tl-v {
    top: 0;
    left: 0;
    width: 3px;
    height: 9px;
}

.expand-bar-br-h {
    top: 15px;
    left: 9px;
    width: 9px;
    height: 3px;
}

.expand-bar-br-v {
    top: 9px;
    left: 15px;
    width: 3px;
    height: 9px;
}

.icon-camera {
    width: 20px;
    height: 14px;
    border-radius: 3px;
    border-width: 1.5px;
    border-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
}

.icon-camera-lens {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    border-width: 1.5px;
    border-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
}

.file-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 360px;
    flex-direction: column;
    background-color: rgb(51, 56, 61);
    border-left-width: 1px;
    border-left-color: rgb(74, 80, 88);
}

.sidebar-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    padding-left: 16px;
    padding-right: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(74, 80, 88);
}

.sidebar-title {
    color: rgb(233, 236, 239);
    font-size: 12px;
    -unity-font-style: bold;
}

.sidebar-head-right {
    flex-direction: row;
}

.side-body {
    flex-grow: 1;
}

.side-body .unity-scroll-view__content-container {
    padding: 18px;
}

.file-card {
    margin-bottom: 22px;
}

.file-card-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(233, 236, 239);
    margin-bottom: 8px;
}

.field-label {
    color: rgb(168, 174, 181);
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.file-row {
    flex-direction: row;
    align-items: center;
    height: 40px;
    margin-bottom: 8px;
}

.file-name {
    flex-grow: 1;
    height: 100%;
    font-size: 13px;
    color: rgb(233, 236, 239);
    background-color: rgb(58, 64, 70);
    border-width: 1px;
    border-color: rgb(74, 80, 88);
    border-radius: 5px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 11px;
    padding-right: 11px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.file-name--empty {
    color: rgb(140, 146, 153);
    -unity-font-style: italic;
}

.file-x {
    width: 38px;
    height: 100%;
    margin-left: 8px;
    padding: 0;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(74, 80, 88);
    background-color: rgb(58, 64, 70);
    color: rgb(217, 119, 106);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.file-x:hover {
    border-color: rgb(217, 119, 106);
}

.load-btn {
    width: 100%;
    margin: 0;
    padding-top: 11px;
    padding-bottom: 11px;
    padding-left: 11px;
    padding-right: 11px;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(74, 80, 88);
    background-color: rgba(0, 0, 0, 0);
    color: rgb(168, 174, 181);
    font-size: 13px;
    -unity-text-align: middle-left;
}

.load-btn:hover {
    border-color: rgb(77, 126, 168);
    color: rgb(77, 126, 168);
}

.err-box {
    height: 160px;
    margin-top: 6px;
    background-color: rgb(58, 64, 70);
    border-width: 1px;
    border-color: rgb(74, 80, 88);
    border-radius: 5px;
}

.err-box .unity-scroll-view__content-container {
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
}

.error-label {
    color: rgb(217, 119, 106);
    font-size: 12px;
    white-space: normal;
}

.load-button {
    height: 46px;
    border-radius: 8px;
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-style: bold;
    background-color: rgb(77, 126, 168);
    margin-top: 4px;
}

.load-button:hover {
    background-color: rgb(90, 142, 186);
}

.param-card {
    margin-top: 22px;
    padding-top: 18px;
    border-top-width: 1px;
    border-top-color: rgb(74, 80, 88);
}

.param-row {
    margin-bottom: 16px;
}

.param-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.param-label {
    color: rgb(168, 174, 181);
    font-size: 12px;
}

.param-value {
    color: rgb(233, 236, 239);
    font-size: 12px;
    -unity-font-style: bold;
}

.param-value:hover {
    color: rgb(77, 126, 168);
}

/* Width only: styling the inner input (especially its height) made the typed text disappear. */
.param-input {
    width: 90px;
}

.param-slider {
    height: 18px;
}

.param-slider .unity-base-slider__tracker {
    height: 5px;
    top: 50%;
    margin-top: -2.5px;
    background-color: rgb(58, 64, 70);
    border-color: rgb(74, 80, 88);
    border-width: 1px;
    border-radius: 3px;
}

.param-slider .unity-base-slider__dragger {
    width: 14px;
    height: 14px;
    top: 50%;
    margin-top: -7px;
    border-radius: 7px;
    border-width: 0;
    background-color: rgb(77, 126, 168);
}

.param-slider .unity-base-slider__dragger:hover {
    background-color: rgb(103, 152, 194);
}

.param-toggle {
    margin-top: 2px;
}

.param-toggle .unity-label {
    color: rgb(168, 174, 181);
    font-size: 12px;
    padding-left: 0;
    min-width: 0;
}

.param-toggle .unity-toggle__input {
    flex-grow: 1;
    justify-content: flex-end;
}

/* Color and border only, never background-image: the theme draws the tick as that image. */
.param-toggle .unity-toggle__checkmark {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(74, 80, 88);
    background-color: rgb(58, 64, 70);
    -unity-background-image-tint-color: rgb(233, 236, 239);
}

.param-toggle:hover .unity-toggle__checkmark {
    border-color: rgb(77, 126, 168);
}

.param-toggle:checked .unity-toggle__checkmark {
    background-color: rgb(77, 126, 168);
    border-color: rgb(77, 126, 168);
}

.color-button {
    width: 56px;
    height: 24px;
    padding: 0;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(74, 80, 88);
}

.color-button:hover {
    border-color: rgb(233, 236, 239);
}

.color-dialog {
    width: 320px;
}

/* Required for wrapping: the dialog centers its children instead of stretching them. */
.swatch-grid {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 18px;
}

.swatch {
    width: 36px;
    height: 36px;
    margin: 4px;
    padding: 0;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(74, 80, 88);
}

.swatch:hover {
    border-color: rgb(233, 236, 239);
}

.color-cancel-button {
    width: 100%;
    height: 40px;
    border-radius: 8px;
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
    background-color: rgb(75, 75, 85);
}

.color-cancel-button:hover {
    background-color: rgb(90, 90, 105);
}

.status-label {
    color: rgb(212, 169, 79);
    font-size: 12px;
    white-space: normal;
    margin-top: 10px;
    -unity-text-align: middle-center;
}

.stats-panel {
    position: absolute;
    top: 70px;
    left: 18px;
    width: 190px;
    background-color: rgb(58, 64, 70);
    border-width: 1px;
    border-color: rgb(74, 80, 88);
    border-radius: 6px;
}

.indicators-head {
    color: rgb(233, 236, 239);
    font-size: 11px;
    -unity-font-style: bold;
    padding: 10px 12px 8px 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(74, 80, 88);
}

.indicators-body {
    padding: 8px 12px 10px 12px;
}

.indicators-divider {
    border-top-width: 1px;
    border-top-color: rgb(74, 80, 88);
    margin-top: 4px;
    margin-bottom: 4px;
}

.particle-count-label {
    color: rgb(233, 236, 239);
    font-size: 11px;
    -unity-font-style: bold;
}

.stats-label {
    color: rgb(168, 174, 181);
    font-size: 11px;
    -unity-font-style: normal;
    margin-bottom: 2.5px;
}

.icon-fullscreen {
    width: 22px;
    height: 22px;
    background-image: url("project://database/Assets/UI/Icons/fullscreen.svg");
    -unity-background-image-tint-color: white;
}

.icon-quit {
    width: 22px;
    height: 22px;
    background-image: url("project://database/Assets/UI/Icons/quit.svg");
    -unity-background-image-tint-color: white;
}

.popup-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.75);
    align-items: center;
    justify-content: center;
}

.popup-dialog {
    width: 340px;
    padding: 30px;
    border-radius: 15px;
    background-color: rgb(35, 35, 45);
    border-width: 1px;
    border-color: rgb(60, 60, 75);
    align-items: center;
}

.popup-title {
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 25px;
    -unity-text-align: middle-center;
}

.popup-buttons {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
}

.popup-button {
    flex: 1;
    height: 44px;
    border-radius: 8px;
    border-width: 0;
    color: white;
    font-size: 15px;
    -unity-font-style: bold;
    margin-left: 5px;
    margin-right: 5px;
}

.confirm-button {
    background-color: rgb(200, 70, 70);
}

.confirm-button:hover {
    background-color: rgb(220, 85, 85);
}

.cancel-button {
    background-color: rgb(75, 75, 85);
}

.cancel-button:hover {
    background-color: rgb(90, 90, 105);
}
