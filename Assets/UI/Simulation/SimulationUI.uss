/*
2026-06-04 AI-Tag
This was created with the help of Assistant, a Unity Artificial Intelligence product.
*/
/* ---- Reset ----
   Unity's built-in runtime theme (imported by SimulationTheme.tss via
   `unity-theme://default`) applies its own margins to Label and Button —
   roughly 3px per side. Left in place, they silently offset every
   Label-based row from every Button-based row, which is what made the
   file rows look misaligned: the name box (a Label) sat ~3px lower and
   ~3px further right than the buttons around it, while the remove button
   (a Button) sat ~3px in from the right edge because only three of its
   four margin sides had been zeroed. Reset both once, here, so every
   position below is determined by this file rather than by theme
   defaults; components opt back in to whatever spacing they need. */
Label,
Button {
    margin: 0;
}

/* Single way to hide/show anything in this UI. Visibility lives in the
   class list (toggled with EnableInClassList) rather than in inline
   styles, so the USS stays the one place that decides what "hidden"
   means and C# never writes style values directly. */
.hidden {
    display: none;
}

.root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* ---- Floating transport / view controls (centered over the viewport) ---- */

.floating-controls-wrap {
    position: absolute;
    top: 14px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.floating-controls {
    flex-direction: row;
    align-items: center;
    padding: 6px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(74, 80, 88);
    background-color: rgba(43, 47, 52, 0.85);
}

.controls-separator {
    width: 1px;
    align-self: stretch;
    margin-left: 6px;
    margin-right: 6px;
    background-color: rgb(74, 80, 88);
}

/* ---- Shared icon-button base: every icon button (transport, ampliar,
   focar câmera, tela cheia, fechar) is the same size and shape. ---- */

.icon-button {
    width: 40px;
    height: 40px;
    margin-left: 4px;
    margin-right: 4px;
    padding: 0;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(74, 80, 88);
    background-color: rgb(58, 64, 70);
    align-items: center;
    justify-content: center;
    transition-duration: 0.15s;
}

/* background-color is repeated in the hover/active rules on purpose:
   these are real Buttons, so Unity's built-in theme ships its own
   :hover/:active background for them. Restating ours here keeps the
   theme from deciding the colour out from under us. */
.icon-button:hover {
    background-color: rgb(58, 64, 70);
    border-color: rgb(77, 126, 168);
}

.icon-button:active {
    background-color: rgb(45, 48, 53);
    border-color: rgb(77, 126, 168);
}

.run-button {
    background-color: rgb(77, 126, 168);
    border-color: rgb(77, 126, 168);
}

.run-button:hover {
    background-color: rgb(90, 142, 186);
    border-color: rgb(90, 142, 186);
}

.quit-button:hover {
    border-color: rgb(217, 119, 106);
}

/* ---- Button icons (drawn with shapes, not text/emoji) ---- */

/* Play: right-pointing triangle via border trick, optically centered.
   A right-pointing isosceles triangle's centroid sits 1/3 of its width
   from the flat edge, so geometric centering reads as shifted left. The
   nudge needed is (width/2 - width/3) = width/6, doubled to width/3
   because a flex container centers the item's *margin* box, so half of an
   asymmetric margin-left is reabsorbed into the centering gap.
   SIZE CONSTRAINT — the triangle's total footprint is
   border-left-width + margin-left = 4/3 * width, and it must stay under
   .icon-button's 38px content box (40px minus its 1px borders), so width
   must not exceed ~28px. A previous pass set width 32 + margin 16 = 48px,
   which silently overflowed the button by 10px (UI Toolkit defaults to
   overflow: visible, so it spilled outside the blue button rather than
   clipping). Keep 4/3 * border-left-width <= 38 when resizing this. */
.icon-play {
    width: 0;
    height: 0;
    margin-left: 8px;
    border-top-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 26px;
    border-right-width: 0;
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgba(0, 0, 0, 0);
}

/* Pause: two vertical bars */
.icon-pause {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.pause-bar {
    width: 5px;
    height: 18px;
    margin-left: 2.5px;
    margin-right: 2.5px;
    border-radius: 2px;
    background-color: rgb(255, 255, 255);
}

/* Stop: square */
.icon-stop {
    width: 17px;
    height: 17px;
    border-radius: 3px;
    background-color: rgb(255, 255, 255);
}

/* Expand/collapse sidebar: two opposite open corner brackets, each built
   from two solid filled bars (same plain-rectangle technique as
   .pause-bar/.icon-stop below) rather than border-width tricks — a filled
   rectangle can't render asymmetrically the way two nominally-equal
   border edges on opposite corners of an element apparently can. */
.icon-expand {
    width: 18px;
    height: 18px;
    position: relative;
}

.expand-bar {
    position: absolute;
    background-color: rgb(255, 255, 255);
}

/* 3px-thick bars (up from 2px) — at 2px, a +-1px sub-pixel rounding
   difference between two nominally-identical elements reads as a 50%
   thickness difference (one corner visibly bolder than the other, even
   with matching USS values); at 3px the same +-1px rounding is a much
   less noticeable ~33%. */
.expand-bar-tl-h {
    top: 0;
    left: 0;
    width: 9px;
    height: 3px;
}

.expand-bar-tl-v {
    top: 0;
    left: 0;
    width: 3px;
    height: 9px;
}

/* Mirrored via explicit top/left offsets (18px container) rather than
   bottom/right — the bottom-right corner rendered broken when anchored
   with bottom/right, so both corners now use the same top/left anchoring
   that already worked correctly for the top-left one. */
.expand-bar-br-h {
    top: 15px;
    left: 9px;
    width: 9px;
    height: 3px;
}

.expand-bar-br-v {
    top: 9px;
    left: 15px;
    width: 3px;
    height: 9px;
}

/* Focar câmera: camera silhouette — outlined body + centered lens circle,
   thin stroke, unfilled (per spec). */
.icon-camera {
    width: 20px;
    height: 14px;
    border-radius: 3px;
    border-width: 1.5px;
    border-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
}

.icon-camera-lens {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    border-width: 1.5px;
    border-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
}

/* ---- Sidebar (configuration panel) ---- */

.file-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 360px;
    flex-direction: column;
    background-color: rgb(51, 56, 61);
    border-left-width: 1px;
    border-left-color: rgb(74, 80, 88);
}

.sidebar-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    padding-left: 16px;
    padding-right: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(74, 80, 88);
}

.sidebar-title {
    color: rgb(233, 236, 239);
    font-size: 12px;
    -unity-font-style: bold;
}

.sidebar-head-right {
    flex-direction: row;
}

.side-body {
    flex-grow: 1;
}

.side-body .unity-scroll-view__content-container {
    padding: 18px;
}

.file-card {
    margin-bottom: 22px;
}

.file-card-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(233, 236, 239);
    margin-bottom: 8px;
}

.field-label {
    color: rgb(168, 174, 181);
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

/* The row owns the height; both children fill it (height: 100%), so the
   remove button can't desync from the name box — the spec's explicit
   requirement — and there's only one number to change. `align-items:
   center` is the backstop that keeps the two aligned even if their
   heights ever diverge again. (The margins that used to offset them are
   handled by the Label/Button reset at the top of this file.) */
.file-row {
    flex-direction: row;
    align-items: center;
    height: 40px;
    margin-bottom: 8px;
}

.file-name {
    flex-grow: 1;
    height: 100%;
    font-size: 13px;
    color: rgb(233, 236, 239);
    background-color: rgb(58, 64, 70);
    border-width: 1px;
    border-color: rgb(74, 80, 88);
    border-radius: 5px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 11px;
    padding-right: 11px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* An emptied slot reads as absence rather than as a filename: muted and
   italic, so "(nenhum arquivo)" is not mistaken for a file actually called
   that. */
.file-name--empty {
    color: rgb(140, 146, 153);
    -unity-font-style: italic;
}

.file-x {
    width: 38px;
    height: 100%;
    margin-left: 8px;
    padding: 0;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(74, 80, 88);
    background-color: rgb(58, 64, 70);
    color: rgb(217, 119, 106);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.file-x:hover {
    border-color: rgb(217, 119, 106);
}

/* Padding-driven height rather than a fixed one, but tuned to land on the
   same 40px as .file-row above it so the two read as one stack. */
.load-btn {
    width: 100%;
    margin: 0;
    padding-top: 11px;
    padding-bottom: 11px;
    padding-left: 11px;
    padding-right: 11px;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(74, 80, 88);
    background-color: rgba(0, 0, 0, 0);
    color: rgb(168, 174, 181);
    font-size: 13px;
    -unity-text-align: middle-left;
}

.load-btn:hover {
    border-color: rgb(77, 126, 168);
    color: rgb(77, 126, 168);
}

/* Fixed-height, independently scrollable error box per file. Starts with
   the `hidden` class in the UXML and is shown only when its own file has
   an error. */
.err-box {
    height: 90px;
    margin-top: 6px;
    background-color: rgb(58, 64, 70);
    border-width: 1px;
    border-color: rgb(74, 80, 88);
    border-radius: 5px;
}

.err-box .unity-scroll-view__content-container {
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
}

.error-label {
    color: rgb(217, 119, 106);
    font-size: 11px;
    white-space: normal;
}

.load-button {
    height: 46px;
    border-radius: 8px;
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-style: bold;
    background-color: rgb(77, 126, 168);
    margin-top: 4px;
}

.load-button:hover {
    background-color: rgb(90, 142, 186);
}

/* ---- Parameter cards (live simulation/visual settings) ---- */

/* Separated from the file cards above by a rule rather than just spacing,
   since these controls act immediately while the file cards only take
   effect on "Carregar simulação". */
.param-card {
    margin-top: 22px;
    padding-top: 18px;
    border-top-width: 1px;
    border-top-color: rgb(74, 80, 88);
}

.param-row {
    margin-bottom: 16px;
}

.param-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.param-label {
    color: rgb(168, 174, 181);
    font-size: 12px;
}

.param-value {
    color: rgb(233, 236, 239);
    font-size: 12px;
    -unity-font-style: bold;
}

.param-value:hover {
    color: rgb(77, 126, 168);
}

/* Swapped in for .param-value while the value is being typed.
   Deliberately almost unstyled — only the outer width is set, and nothing
   inside the field is touched. An earlier version styled the field's inner
   input (fixed `height: 22px`, padding, text-align, colours) and the field
   then drew *no text at all*: confirmed by sampling the rendered field,
   whose interior came back as 616 pixels of a single flat colour, with not
   one anti-aliased glyph pixel among them. Not even the pre-filled value
   showed. Pinning the height of the input container evidently collapses
   the text element inside it, and the built-in field's own styling renders
   correctly, so it is left alone. If this needs to match the panel better,
   re-add properties ONE at a time and check each against a real render —
   `background-color` first, never a height. */
.param-input {
    width: 90px;
}

.param-slider {
    height: 18px;
}

/* Track and knob are both pinned to the midline of the same container
   (top: 50% offset back by half their own height) instead of inheriting
   whatever vertical placement the built-in theme computed for its own
   default knob size. Resizing the knob was exactly what knocked it out of
   line before — it ended up flush with the bottom of the track — and
   centring each on 50% makes the alignment independent of both the theme's
   defaults and of the sizes chosen here. */
.param-slider .unity-base-slider__tracker {
    height: 5px;
    top: 50%;
    margin-top: -2.5px;
    background-color: rgb(58, 64, 70);
    border-color: rgb(74, 80, 88);
    border-width: 1px;
    border-radius: 3px;
}

.param-slider .unity-base-slider__dragger {
    width: 14px;
    height: 14px;
    top: 50%;
    margin-top: -7px;
    border-radius: 7px;
    border-width: 0;
    background-color: rgb(77, 126, 168);
}

.param-slider .unity-base-slider__dragger:hover {
    background-color: rgb(103, 152, 194);
}

.param-toggle {
    margin-top: 2px;
}

/* min-width defeats the 120px that the base-field label style reserves for
   Inspector-style alignment, which this panel doesn't want; padding-left: 0
   lines this label up with the plain .param-label rows above it, which start
   flush at the card's edge. */
.param-toggle .unity-label {
    color: rgb(168, 174, 181);
    font-size: 12px;
    padding-left: 0;
    min-width: 0;
}

/* Puts the checkmark hard right, matching the sliders' value readouts and
   the colour buttons. The field's input area already grows to fill the row
   (that's the base-field default), so the checkmark would otherwise sit at
   its left edge, immediately after the text, instead of at the row's end —
   which is exactly what made this row look out of line with the others. */
.param-toggle .unity-toggle__input {
    flex-grow: 1;
    justify-content: flex-end;
}

/* The checkmark is styled through background-color and border only —
   never background-image. The built-in theme draws the tick itself as a
   background-image that appears on :checked, so replacing the image would
   leave the checked state with nothing to show; setting only the colour
   behind it keeps that tick intact and just recolours the box around it.
   The tint keeps the tick legible against the accent fill. */
.param-toggle .unity-toggle__checkmark {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(74, 80, 88);
    background-color: rgb(58, 64, 70);
    -unity-background-image-tint-color: rgb(233, 236, 239);
}

.param-toggle:hover .unity-toggle__checkmark {
    border-color: rgb(77, 126, 168);
}

.param-toggle:checked .unity-toggle__checkmark {
    background-color: rgb(77, 126, 168);
    border-color: rgb(77, 126, 168);
}

/* Basic-color picker. The button shows the colour currently in effect and
   opens a popup; the swatches live in that popup, built in C#
   (SimulationUIController owns the palette) so the colour list exists in
   exactly one place instead of being duplicated between a USS class per
   colour and a C# Color per swatch. Adding a colour is one array entry,
   and the popup grid wraps to fit however many there are. These rules only
   cover shape and spacing. */
.color-button {
    width: 56px;
    height: 24px;
    padding: 0;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(74, 80, 88);
}

.color-button:hover {
    border-color: rgb(233, 236, 239);
}

/* 320px minus the dialog's 30px padding leaves 260px of content, which fits
   five 36px swatches plus their 4px margins per row. */
.color-dialog {
    width: 320px;
}

/* width: 100% is what makes flex-wrap work at all here — the dialog centers
   its children rather than stretching them, so without an explicit width
   this grid would size to its content, never hit a wrap boundary, and run
   all the swatches into one row past the dialog's edge. Constrained to the
   dialog's content width it wraps at four per row and grows downward as
   colours are added to the palette. */
.swatch-grid {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 18px;
}

.swatch {
    width: 36px;
    height: 36px;
    margin: 4px;
    padding: 0;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(74, 80, 88);
}

.swatch:hover {
    border-color: rgb(233, 236, 239);
}

/* Deliberately not reusing .popup-button here: that class carries flex: 1
   for the side-by-side pair in the quit dialog, and this button is a direct
   child of a column, where flex-grow would stretch it down the dialog. */
.color-cancel-button {
    width: 100%;
    height: 40px;
    border-radius: 8px;
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
    background-color: rgb(75, 75, 85);
}

.color-cancel-button:hover {
    background-color: rgb(90, 90, 105);
}

.status-label {
    color: rgb(212, 169, 79);
    font-size: 12px;
    white-space: normal;
    margin-top: 10px;
    -unity-text-align: middle-center;
}

/* ---- Indicators panel (top-left, over the viewport) ---- */

.stats-panel {
    position: absolute;
    top: 70px;
    left: 18px;
    width: 190px;
    background-color: rgb(58, 64, 70);
    border-width: 1px;
    border-color: rgb(74, 80, 88);
    border-radius: 6px;
}

.indicators-head {
    color: rgb(233, 236, 239);
    font-size: 11px;
    -unity-font-style: bold;
    padding: 10px 12px 8px 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(74, 80, 88);
}

.indicators-body {
    padding: 8px 12px 10px 12px;
}

.indicators-divider {
    border-top-width: 1px;
    border-top-color: rgb(74, 80, 88);
    margin-top: 4px;
    margin-bottom: 4px;
}

.particle-count-label {
    color: rgb(233, 236, 239);
    font-size: 11px;
    -unity-font-style: bold;
}

.stats-label {
    color: rgb(168, 174, 181);
    font-size: 11px;
    -unity-font-style: normal;
    margin-bottom: 2.5px;
}

/* ---- Sidebar icons that still use image assets (unchanged) ---- */

.icon-fullscreen {
    width: 22px;
    height: 22px;
    background-image: url("project://database/Assets/UI/Icons/fullscreen.svg");
    -unity-background-image-tint-color: white;
}

.icon-quit {
    width: 22px;
    height: 22px;
    background-image: url("project://database/Assets/UI/Icons/quit.svg");
    -unity-background-image-tint-color: white;
}

/* ---- Popups ---- */

.popup-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.75);
    align-items: center;
    justify-content: center;
}

.popup-dialog {
    width: 340px;
    padding: 30px;
    border-radius: 15px;
    background-color: rgb(35, 35, 45);
    border-width: 1px;
    border-color: rgb(60, 60, 75);
    align-items: center;
}

.popup-title {
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 25px;
    -unity-text-align: middle-center;
}

.popup-buttons {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
}

.popup-button {
    flex: 1;
    height: 44px;
    border-radius: 8px;
    border-width: 0;
    color: white;
    font-size: 15px;
    -unity-font-style: bold;
    margin-left: 5px;
    margin-right: 5px;
}

.confirm-button {
    background-color: rgb(200, 70, 70);
}

.confirm-button:hover {
    background-color: rgb(220, 85, 85);
}

.cancel-button {
    background-color: rgb(75, 75, 85);
}

.cancel-button:hover {
    background-color: rgb(90, 90, 105);
}
